# --- Supabase (Project Configuration) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable keys are safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SERVER ONLY. Supabase dashboard > Project Settings > API Keys > secret key. Never commit it or prefix it NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# --- Backblaze B2 Storage (S3 Compatible) ---
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_CLIPS=zclip-private-media-2026
B2_BUCKET_EXPORTS=zclip-private-media-2026

# --- AI (optional: without a key a basic deterministic editor is used) ---
GEMINI_API_KEY=
# Verify the current model ID in Google's docs before relying on it.
GEMINI_MODEL=gemini-2.5-flash
# Optional USD per 1M tokens, used only for cost estimates.
GEMINI_PRICE_IN_PER_M=
GEMINI_PRICE_OUT_PER_M=

# --- Optional: full paths if ffmpeg/ffprobe are not on your PATH ---
FFMPEG_PATH=
FFPROBE_PATH=
